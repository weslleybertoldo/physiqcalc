{
  "ignoreCommand": "bash scripts/vercel/ignorar-build.sh",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/exercicios/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/workbox-(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "physiqcalc.vercel.app" }],
      "destination": "https://physiqcalc.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "physiqcalc.vercel.app" }],
      "destination": "https://physiqcalc.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "nutri.physiqcalc.com.br" }],
      "destination": "https://physiqcalc.com.br/?origem=nutri",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nutri.physiqcalc.com.br" }],
      "destination": "https://physiqcalc.com.br/:path*?origem=nutri",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/|.*\\.(?:js|css|png|jpg|jpeg|svg|ico|webp|webmanifest|json|woff2?|ttf|wasm)|sw\\.js|workbox-.*|registerSW\\.js|manifest\\.json).*)", "destination": "/index.html" }
  ]
}
