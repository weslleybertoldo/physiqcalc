VITE_SUPABASE_URL="https://uxwpwdbbnlticxgtzcsb.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key-publica>"
# Ambiente de dados: "public" (PROD) ou "staging".
VITE_DB_SCHEMA="public"
# Instância PowerSync. Prod usa a default; o build de staging SEM esta variável fica sem PowerSync (src/lib/powersync/instancia.ts).
# Só defina para apontar uma instância própria do staging (sync rules no schema staging).
# VITE_POWERSYNC_URL="https://<instancia-staging>.powersync.journeyapps.com"

# A URL da API pode ser o domínio próprio (proxy Cloudflare → Supabase); as regras de cache do
# service worker (vite.config.ts) seguem esta variável. Ver docs/api-dominio-proprio.md.
# VITE_SUPABASE_URL="https://api.physiqcalc.com.br"
